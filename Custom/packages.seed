# ============================================================================
# AX6 定制插件清单（人读 + 机器读）
#
# 由 Custom/bootstrap-fork.sh 复制成 Config/PRIVATE.txt，
# 被上游 Scripts/Settings.sh 追加到 .config 末尾（即在 GENERAL.txt 之后，
# 所以这里的 is-not-set 可以覆盖 GENERAL.txt 里的 =y）。
#
# 加包 / 删包只改这个文件，然后重跑 bootstrap 即可。
# ============================================================================

# ---- 主题：argon（WRT_THEME 在 CUSTOM-AX6.yml 里指定）----
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ---- 内核模块：ZeroTier / EasyTier 的 TUN/TAP 依赖 ----
CONFIG_PACKAGE_kmod-tun=y

# ---- EasyTier（上游 Packages.sh 已从 EasyTier/luci-app-easytier 拉取）----
# noweb = 用预编译二进制，编译快；想源码编译就换成 easytier=y / easytier-noweb=n
CONFIG_PACKAGE_easytier-noweb=y
CONFIG_PACKAGE_easytier=n
CONFIG_PACKAGE_luci-app-easytier=y

# ---- ZeroTier ----
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y

# ---- ddns-go（上游 Packages.sh 已从 sirpdboy/luci-app-ddns-go 拉取）----
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-ddns-go=y

# ---- iStore 软件商店（4 个子包，由 Scripts/PRIVATE.sh 落位到 package/ 顶层）----
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_taskd=y

# ---- 微信/Telegram/邮件推送（由 Scripts/PRIVATE.sh 拉取）----
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_iputils-arping=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-compat=y

# ============================================================================
# 从 openwrt-ci-roc 迁过来的插件（菜单里原本有、新项目缺的）
# ============================================================================

# ---- PassWall（源码由上游 Scripts/Packages.sh 以 pkg 模式从
#      Openwrt-Passwall/openwrt-passwall 拉取，落到 package/luci-app-passwall）
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=y
# 体积大且用不到的组件，按旧项目 openwrt-ci-roc 的取舍保持关闭
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan_Plus is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_tuic_client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin is not set

# ---- 动态 DNS（含 Cloudflare 的 API 脚本）----
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y

# ---- frp 内网穿透：客户端 + 服务端 ----
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-app-frps=y

# ---- uHTTPd 配置界面（系统默认就跑 uhttpd，只是缺 LuCI 前端）----
CONFIG_PACKAGE_luci-app-uhttpd=y

# ============================================================================
# CUT-BEGIN —— 这行以下为「裁剪」段，上面的都算新增安装
# ============================================================================

# ---- btrfs / samba ----
# CONFIG_PACKAGE_kmod-fs-btrfs is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set

# ---- 不要 HomeProxy（上游 GENERAL.txt 默认 =y，这里覆盖掉）----
# CONFIG_PACKAGE_luci-app-homeproxy is not set

# ---- USB 核心与主机控制器 ----
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-common is not set
# CONFIG_PACKAGE_kmod-usb-dwc3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3-qcom is not set
# CONFIG_PACKAGE_kmod-usb-xhci-hcd is not set
# CONFIG_PACKAGE_kmod-usb-ohci is not set
# CONFIG_PACKAGE_kmod-usb-uhci is not set

# ---- USB 网络（RNDIS / CDC / 各种网卡驱动）----
# CONFIG_PACKAGE_kmod-usb-net is not set
# CONFIG_PACKAGE_kmod-usb-net-asix is not set
# CONFIG_PACKAGE_kmod-usb-net-asix-ax88179 is not set
# CONFIG_PACKAGE_kmod-usb-net-cdc-eem is not set
# CONFIG_PACKAGE_kmod-usb-net-cdc-ether is not set
# CONFIG_PACKAGE_kmod-usb-net-cdc-mbim is not set
# CONFIG_PACKAGE_kmod-usb-net-cdc-ncm is not set
# CONFIG_PACKAGE_kmod-usb-net-cdc-subset is not set
# CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm is not set
# CONFIG_PACKAGE_kmod-usb-net-ipheth is not set
# CONFIG_PACKAGE_kmod-usb-net-rndis is not set
# CONFIG_PACKAGE_kmod-usb-net-rtl8150 is not set
# CONFIG_PACKAGE_kmod-usb-net-rtl8152 is not set
# CONFIG_PACKAGE_kmod-usb-net-sierrawireless is not set

# ---- USB 串口 / WWAN / 存储 ----
# CONFIG_PACKAGE_kmod-usb-serial is not set
# CONFIG_PACKAGE_kmod-usb-serial-qualcomm is not set
# CONFIG_PACKAGE_kmod-usb-serial-wwan is not set
# CONFIG_PACKAGE_kmod-usb-wdm is not set
# CONFIG_PACKAGE_kmod-usb-roles is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_kmod-usb-storage-extras is not set
# CONFIG_PACKAGE_kmod-usb-storage-uas is not set

# ---------------------------------------------------------------------------
# 上面那些是「直接关」，但如果还有包 select 它们，kconfig 会重新拉回来。
# 下面这些是「依赖源」——关掉它们，USB / btrfs / samba 才会真正消失。
# AX6 没有 USB 口、没有 eMMC/SD，这些功能一个都用不上。
# ---------------------------------------------------------------------------

# automount / 磁盘管理：依赖 kmod-usb-storage + kmod-fs-btrfs
# CONFIG_PACKAGE_automount is not set
# CONFIG_PACKAGE_luci-app-mini-diskmanager is not set

# USB 模式切换 / iOS 设备 / 移动宽带：依赖 kmod-usb-core + kmod-usb-serial-*
# CONFIG_PACKAGE_usb-modeswitch is not set
# CONFIG_PACKAGE_usbmuxd is not set
# CONFIG_PACKAGE_libimobiledevice is not set

# 磁盘健康检测：依赖 usb-storage / ata
# CONFIG_PACKAGE_smartmontools is not set
# CONFIG_PACKAGE_smartmontools-drivedb is not set

# samba 内核侧（luci-app-samba4 关了，内核模块也一起去掉）
# CONFIG_PACKAGE_kmod-fs-ksmbd is not set

# exFAT 工具（U 盘用，AX6 无 USB）
# CONFIG_PACKAGE_exfat-fsck is not set
# CONFIG_PACKAGE_exfat-mkfs is not set

# ---------------------------------------------------------------------------
# 第三层：target 的 DEFAULT_PACKAGES
#
# 这一层比 CONFIG_PACKAGE_* 更强势：它们由 target/profile 的
# DEFAULT_PACKAGES 列表注入，符号是 CONFIG_DEFAULT_<pkg>，
# 会把 PACKAGE_<pkg> 及其依赖整体拉回来（automount 就会拖来
# kmod-usb-storage* + kmod-fs-btrfs + btrfs-progs）。
#
# 实测 .config 里出现这些就说明还堵着：
#   CONFIG_DEFAULT_kmod-usb3=y / CONFIG_DEFAULT_automount=y
# ---------------------------------------------------------------------------
# CONFIG_DEFAULT_automount is not set
# CONFIG_DEFAULT_kmod-usb3 is not set
# CONFIG_DEFAULT_kmod-usb-dwc3 is not set
# CONFIG_DEFAULT_kmod-usb-dwc3-qcom is not set
# CONFIG_DEFAULT_kmod-usb-serial-qualcomm is not set
